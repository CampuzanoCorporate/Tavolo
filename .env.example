# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
DB_USER=tavolo
DB_PASSWORD=tavolo_secret
DB_NAME=tavolo_pos
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ─── SERVIDOR BACKEND ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── JWT / AUTENTICACIÓN ─────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_en_produccion_minimo_32_chars
JWT_EXPIRES_IN=8h
CERT_ENCRYPTION_SECRET=cambia_este_secreto_y_que_no_sea_igual_al_jwt

# ─── VERI*FACTU / AEAT ───────────────────────────────────────────────────────
# El certificado se carga desde administración y se usa para la conexión mTLS.
# Para envío real, cambia AEAT_DELIVERY_MODE=real y configura los datos del SIF.
AEAT_DELIVERY_MODE=simulate
AEAT_ENDPOINT_URL="https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP"
AEAT_TIMEOUT_MS=15000
AEAT_SOFTWARE_DEVELOPER_NAME="Tavolo POS"
AEAT_SOFTWARE_DEVELOPER_NIF=""
AEAT_SOFTWARE_NAME="TAVOLOPOS"
AEAT_SOFTWARE_ID="01"
AEAT_SOFTWARE_VERSION="1.0.0"
AEAT_SOFTWARE_INSTALLATION_ID="tavolo-vm-01"
AEAT_SOFTWARE_ONLY_VERIFACTU="S"
AEAT_SOFTWARE_MULTI_OT="N"
AEAT_SOFTWARE_MULTIPLE_OT_INDICATOR="N"

BUSINESS_NAME="Tavolo Demo"
BUSINESS_NIF="B12345678"
BUSINESS_ADDRESS="Calle Demo 1, Madrid"
INVOICE_SERIES="T"

# ─── LICENCIAS ────────────────────────────────────────────────────────────────
LICENSE_MASTER_KEY="cambia_esta_clave_maestra"
LICENSE_VALIDITY_DAYS=30
LICENSE_GRACE_DAYS=7

# ─── FRONTEND (solo para build) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── EJEMPLO PRODUCCIÓN UNIFICADA ────────────────────────────────────────────
