# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
DB_USER=tavolo
DB_PASSWORD=tavolo_secret
DB_NAME=tavolo_pos
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ─── SERVIDOR BACKEND ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── JWT / AUTENTICACIÓN ─────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_en_produccion_minimo_32_chars
JWT_EXPIRES_IN=8h

# ─── VERI*FACTU / AEAT ───────────────────────────────────────────────────────
# En producción, usar el certificado real de la FNMT
# CERT_PATH="./certs/certificado.p12"
# CERT_PASSWORD="tu_password_del_certificado"

# Endpoint AEAT (preproducción/producción)
AEAT_ENDPOINT_URL="https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/FacturaSimplificada"

# ─── FRONTEND (solo para build) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
