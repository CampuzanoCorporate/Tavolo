# ─── BASE DE DATOS ───────────────────────────────────────────────────────────
DB_USER=tavolo
DB_PASSWORD=tavolo_secret
DB_NAME=tavolo_pos
DB_HOST=localhost
DB_PORT=5433
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ─── SERVIDOR BACKEND ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── SEGURIDAD / CRIPTOGRAFÍA ────────────────────────────────────────────────
# Secreto para tokens de autenticación JWT (mínimo 32 caracteres)
JWT_SECRET=cambia_este_secreto_en_produccion_minimo_32_chars
JWT_EXPIRES_IN=8h
# Secreto para cifrado AES-256 de los certificados fiscales (.p12/.pfx) en base de datos
CERT_ENCRYPTION_SECRET=cambia_este_secreto_en_produccion_distinto_32_chars

# ─── LICENCIAMIENTO ──────────────────────────────────────────────────────────
LICENSE_MASTER_KEY=tavolo-master-license-key-change-in-prod
LICENSE_VALIDITY_DAYS=30
LICENSE_GRACE_DAYS=7

# ─── FRONTEND (para build de la SPA) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── NOTA: CONFIGURACIÓN FISCAL Y VERI*FACTU ─────────────────────────────────
# Todos los datos de la empresa (Razón Social, NIF, Dirección, etc.) y la
# configuración de Hacienda / Veri*Factu (Entorno Pruebas vs Producción,
# Certificado digital mTLS y logotipo) se configuran directamente desde la
# Interfaz de Usuario en el panel: Administración > Fiscal y Cierres.
